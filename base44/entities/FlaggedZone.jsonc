      "title": "Longitude"
    },
    "radius_miles": {
      "type": "number",
      "title": "Radius (Miles)"
    },
    "historical_note": {
      "type": "string",
      "title": "Historical Note"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "last_updated": {
      "type": "string",
      "title": "Last Updated"
    }
